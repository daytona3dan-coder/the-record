{
  "name": "the-record",
  "version": "0.1.0",
  "description": "Shared open core for the independent Record Method and Record Method Keep products.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "echo \"No build step required.\"",
    "test": "node --test tests/*.test.js",
    "validate:record": "node scripts/validate-record.js",
    "check:supersession": "node scripts/check-supersession.js",
    "check:immutability": "node scripts/check-entry-immutability.js",
    "build:state": "node scripts/build-current-state.js",
    "generate:next-chat": "node scripts/generate-next-chat.js",
    "bootstrap:agent": "node scripts/agent-bootstrap.js",
    "check:agent-bootstrap": "node scripts/agent-bootstrap.js --product chatvaultai --check",
    "record:create-product": "node scripts/create-product-record.js",
    "record:intake": "node scripts/evidence-store.js intake",
    "record:verify-evidence": "node scripts/evidence-store.js verify",
    "check:evidence-references": "node scripts/evidence-store.js check-references",
    "keep:init": "node scripts/record-method-keep.js init",
    "keep:intake": "node scripts/record-method-keep.js intake",
    "keep:verify": "node scripts/record-method-keep.js verify",
    "keep:list": "node scripts/record-method-keep.js list"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
