{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-record/schemas/product-profile.schema.json",
  "title": "Product Profile",
  "description": "Profile record for a product registered in The Record.",
  "type": "object",
  "required": [
    "schema_version",
    "product_id",
    "display_name",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Semantic version of the product-profile schema."
    },
    "product_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
      "description": "Lowercase alphanumeric identifier with optional internal hyphens."
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable product name."
    },
    "created_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of product registration."
    },
    "description": {
      "type": "string",
      "description": "Optional longer description of the product."
    },
    "repository": {
      "type": "object",
      "description": "Reference to the product's source repository. Read-only; not connected.",
      "properties": {
        "provider": {
          "type": "string",
          "description": "Repository hosting provider (e.g., github)."
        },
        "owner": {
          "type": "string",
          "description": "Repository owner or organization."
        },
        "repository": {
          "type": "string",
          "description": "Repository name."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
