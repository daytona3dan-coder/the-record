{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-record/schemas/record-entry.schema.json",
  "title": "Record Entry",
  "description": "An append-only governing record entry in The Record system.",
  "type": "object",
  "required": [
    "schema_version",
    "entry_id",
    "created_at",
    "created_by",
    "scope",
    "authority_class",
    "summary",
    "decisions",
    "completed_work",
    "active_state",
    "open_items",
    "supersedes",
    "evidence",
    "next_chat_starting_context"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "entry_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "object",
      "required": ["actor_type", "name"],
      "properties": {
        "actor_type": {
          "type": "string",
          "enum": ["human", "ai"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "account": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "string",
      "enum": ["ecosystem", "product", "workstream"]
    },
    "product_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$|^[a-z0-9]$",
      "description": "Required when scope is 'product'. Identifies which product this entry belongs to."
    },
    "authority_class": {
      "type": "string",
      "enum": [
        "source_evidence",
        "derived_summary",
        "working_context",
        "approved_canon",
        "superseded"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "decisions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "completed_work": {
      "type": "array",
      "items": { "type": "string" }
    },
    "active_state": {
      "type": "object"
    },
    "open_items": {
      "type": "array",
      "items": { "type": "string" }
    },
    "supersedes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact"],
        "properties": {
          "artifact": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "description": {
            "type": "string"
          },
          "spans": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["unit", "start", "end"],
              "properties": {
                "unit": {
                  "type": "string",
                  "enum": ["message", "line", "byte"]
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "next_chat_starting_context": {
      "type": "string"
    },
    "approval": {
      "type": "object",
      "required": ["approved_by_type", "approved_by_name", "approved_by_account", "approved_at"],
      "properties": {
        "approved_by_type": {
          "type": "string",
          "const": "human"
        },
        "approved_by_name": {
          "type": "string",
          "minLength": 1
        },
        "approved_by_account": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "authority_class": { "const": "approved_canon" } },
        "required": ["authority_class"]
      },
      "then": {
        "required": ["approval"]
      }
    },
    {
      "if": {
        "properties": { "scope": { "const": "product" } },
        "required": ["scope"]
      },
      "then": {
        "required": ["product_id"]
      }
    }
  ],
  "additionalProperties": false
}
